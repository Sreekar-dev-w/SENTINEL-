# Local launcher defaults to development mode. Container deployments default to
# production mode and require SENTINEL_JWT_SECRET before protected routes work.
SENTINEL_ENV=development
# Export these launcher values before running `make run`.
SENTINEL_HOST=127.0.0.1
SENTINEL_PORT=8000
# Compose publishes both containers on loopback by default. Override only when
# an intentional external bind is required.
SENTINEL_BIND_HOST=127.0.0.1
SENTINEL_BACKEND_PORT=8000
SENTINEL_FRONTEND_PORT=8080
# Explicit browser origins for separately hosted frontends. The production
# Netlify origin is allowed by default; set this to a comma-separated list when
# using a different frontend or local cross-origin development server.
# SENTINEL_CORS_ORIGINS=https://dashboard.example.test
# Optional external-tool configuration. These adapters remain opt-in per scan
# and still require an active engagement with the matching capability.
SENTINEL_ZAP_URL=http://127.0.0.1:8080
# SENTINEL_ZAP_API_KEY=
SENTINEL_NMAP_EXECUTABLE=nmap
SENTINEL_TESTSSL_EXECUTABLE=testssl.sh

# Optional durable single-node state. Leave unset for ephemeral in-memory tests.
# In Compose, state is stored in the named sentinel-data volume.
# SENTINEL_STATE_DB=/data/sentinel.sqlite3

# Optional local single-user browser bearer token. Vite embeds this in browser
# JavaScript; do not use a shared value for multi-user production deployments.
# VITE_API_TOKEN=
