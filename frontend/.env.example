# API origin. For a Netlify frontend, set this to the deployed FastAPI origin;
# leaving it empty calls the current Netlify origin and will not reach SENTINEL.
VITE_API_BASE_URL=
# Optional local single-user bearer token. This is embedded in browser JavaScript
# and must not be treated as a safe multi-user production secret.
# VITE_API_TOKEN=
# Vite development proxy target. The backend must be running locally.
VITE_DEV_API_TARGET=http://127.0.0.1:8000
